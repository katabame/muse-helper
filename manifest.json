{
  "manifest_version": 3,
  "name": "Muse Helper",
  "version": "0.5.0",
  "description": "Muse (muse.ai) の Web 版に、使い勝手をよくする機能を追加する拡張機能です。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://muse.ai/*"],
      "js": ["common.js", "content.js", "settings.js", "counter.js", "drafts.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://muse.ai/*"],
      "js": ["timestamps.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
